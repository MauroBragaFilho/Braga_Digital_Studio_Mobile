<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Necessárias para a fonte "Sony Camera (Wi-Fi)": descoberta SSDP e leitura
         do SSID da rede DIRECT-xxxx da câmera exigem uma dessas duas, dependendo
         da versão do Android (minSdk 26 até targetSdk 35 cobre as duas eras):
         - ACCESS_FINE_LOCATION: exigida pelo Android 8–12 para WifiManager expor
           resultados de scan e o SSID conectado (sem ela, getSSID() retorna um
           valor de SSID desconhecido/vazio e a descoberta/validação de rede falha).
         - NEARBY_WIFI_DEVICES (Android 13+): substitui a exigência de localização
           para esse mesmo propósito. usesPermissionFlags="neverForLocation"
           porque o app não deriva localização física do Wi-Fi, só conectividade —
           isso é o que permite pedir essa permissão sem também exigir localização
           precisa do usuário no Android 13+.
         - CHANGE_WIFI_STATE / CHANGE_NETWORK_STATE: a rede da câmera não tem
           internet; o app pede a rede Wi-Fi com ConnectivityManager.requestNetwork
           e vincula SÓ os sockets da Sony a ela (SonyNetwork), sem
           bindProcessToNetwork. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Necessárias para manter o LinkServer (Ktor, porta 8080) vivo em segundo
         plano através de um Foreground Service, mesmo com o app fechado/tela
         apagada. FOREGROUND_SERVICE_DATA_SYNC é exigida a partir do Android 14
         (API 34) para o tipo "dataSync", o mais adequado aqui: o service não
         fala com um dispositivo Bluetooth/USB específico (isso pediria
         "connectedDevice"), ele serve dados (mídia, LUTs, estado) via HTTP/WS
         para quem estiver na rede local. POST_NOTIFICATIONS é exigida no
         Android 13+ para exibir a notificação persistente do service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Sessão de captura desacoplada da tela (CaptureForegroundService, em core-media): o tipo
         "camera" exige CAMERA e o "microphone" exige RECORD_AUDIO concedidas (Android 14+). Mantém
         câmera/microfone vivos com a tela apagada, na Home ou em outra tela do app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Roteamento do microfone Bluetooth (SCO): BLUETOOTH_CONNECT é runtime no Android 12+
         (AudioCaptureService confere antes de usar) e startBluetoothSco exige MODIFY_AUDIO_SETTINGS.
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS foi removida: nenhum código a usa e a Play restringe. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Bibliotecas (UVCAndroid) herdam permissões de armazenamento amplas. O app grava só
         em diretórios próprios (getExternalFilesDir/MediaStore), então são removidas do
         manifest mesclado. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />

    <!-- O render exige OpenGL ES 3.0 (shaders "#version 300 es", textura 3D, PBO). -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" tools:node="replace" />

    <application
        android:name=".BdsmApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BragaStudioMobile">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale|layoutDirection|locale"
            android:theme="@style/Theme.BragaStudioMobile.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Botões Permitir/Recusar da notificação de pareamento (só PendingIntents internos). -->
        <receiver
            android:name="com.bragastudio.mobile.network.service.PairingActionReceiver"
            android:exported="false" />

        <service
            android:name="com.bragastudio.mobile.network.service.LinkServerService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

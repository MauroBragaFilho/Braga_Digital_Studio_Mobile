<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Necessárias para a fonte "Sony Camera (Wi-Fi)": descoberta SSDP e leitura
         do SSID da rede DIRECT-xxxx da câmera exigem uma dessas duas, dependendo
         da versão do Android (minSdk 26 até targetSdk 34 cobre as duas eras):
         - ACCESS_FINE_LOCATION: exigida pelo Android 8–12 para WifiManager expor
           resultados de scan e o SSID conectado (sem ela, getSSID() retorna um
           valor de SSID desconhecido/vazio e a descoberta/validação de rede falha).
         - NEARBY_WIFI_DEVICES (Android 13+): substitui a exigência de localização
           para esse mesmo propósito. usesPermissionFlags="neverForLocation"
           porque o app não deriva localização física do Wi-Fi, só conectividade —
           isso é o que permite pedir essa permissão sem também exigir localização
           precisa do usuário no Android 13+.
         - CHANGE_WIFI_STATE / CHANGE_NETWORK_STATE: a rede da câmera não tem
           internet, então o Android tende a desconectar dela automaticamente a
           menos que o app vincule o processo a essa rede explicitamente. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Necessárias para manter o LinkServer (Ktor, porta 8080) vivo em segundo
         plano através de um Foreground Service, mesmo com o app fechado/tela
         apagada. FOREGROUND_SERVICE_DATA_SYNC é exigida a partir do Android 14
         (API 34) para o tipo "dataSync", o mais adequado aqui: o service não
         fala com um dispositivo Bluetooth/USB específico (isso pediria
         "connectedDevice"), ele serve dados (mídia, LUTs, estado) via HTTP/WS
         para quem estiver na rede local. POST_NOTIFICATIONS é exigida no
         Android 13+ para exibir a notificação persistente do service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Opcional, mas recomendada: fabricantes como Samsung/Xiaomi/Huawei podem
         matar o service mesmo sendo Foreground por otimizações de bateria
         próprias. Usada para pedir ao usuário que isente o app (ver MainActivity). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".BsmApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BragaStudioMobile">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.BragaStudioMobile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.braga.bdsm.network.service.LinkServerService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

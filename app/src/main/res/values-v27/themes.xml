<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema XML (janela/splash): claro em values*, escuro em values-night*. Atributos por API ficam
         nos qualificadores v27/v31; cada estilo SUBSTITUI o anterior por inteiro, então repetem tudo. -->
    <style name="Theme.BragaStudioMobile" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
